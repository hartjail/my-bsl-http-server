// Include the BSL socket library (Installed via "bzg install socket")
include("lib/socket.bzg");

// 1. Initialize Socket
if (socket_init() < 0) {
    print("Socket Initialization Failed\n");
} else {
    print("Socket Ready\n");
}

// 2. Create Socket Server
var server = socket_create();
if (server < 0) {
    print("Socket Creation Failed\n");
}

// 3. Bind Server to Port 8080
if (socket_bind(server, 0, 8080) < 0) {
    print("Socket Bind Failed.\n");
}

// 4. Listen for incoming connections
if (socket_listen(server, 5) < 0) {
    print("socket_listen() Failed.\n");
}

print("Server running on http://localhost:8080/\n");

while (1) {
    // 5. Accept Client Connection
    var client = socket_accept(server);
    print("Client connected!\n");

    var data = socket_read(client, 1024);

    if (sizeof(data) >= 0) {
        print("Received Request:\n" + data);

        var BODY = "";
        var HTTP = "";

        var match = regex("/.* HTTP/1.1", data);
        var path = substr(match, 0, sizeof(match) - 9);
        print("File Requested: " + path);

        // Route Handling Logic
        if (path == "/") {
            BODY = "<!DOCTYPE html><html><head><title>BSL Server - Home</title></head>"
                + "<body style='font-family:sans-serif;'>"
                + "<h1 style='color:#818cf8;'>Welcome to Our Platform</h1>"
                + "<p>We are glad to have you here.</p>"
                + "</body></html>";
            HTTP = "HTTP/1.1 200 OK\r\n"
                + "Content-Type: text/html\r\n"
                + "Content-Length: " + sizeof(BODY) + "\r\n"
                + "Connection: close\r\n\r\n";
        } else if (path == "/about") {
            BODY = "<!DOCTYPE html><html><head><title>BSL Server - About</title></head>"
                + "<body style='font-family:sans-serif;'>"
                + "<h1 style='color:#818cf8;'>About BSL HTTP Server</h1>"
                + "<p>This project is a web application designed to demonstrate HTTP routing and dynamic content handling.</p>"
                + "<h2 style='color:#818cf8;'>About the Developer</h2>"
                + "<p>Hi, I'm <strong>Hartzell Guiang</strong>, an Information Technology student majoring in Networks at Mindanao State University Iligan Institute of Technology (MSU-IIT).</p>"
                + "<p>I study computer networking, network security, and I'm interested in pursuing cybersecurity</p>"
                + "</body></html>";
            HTTP = "HTTP/1.1 200 OK\r\n"
                + "Content-Type: text/html\r\n"
                + "Content-Length: " + sizeof(BODY) + "\r\n"
                + "Connection: close\r\n\r\n";
        } else {
            BODY = "<!DOCTYPE html><html><head><title>404 Not Found</title></head>"
                + "<body style='font-family:sans-serif;'>"
                + "<h1 style='color:#4c0519;'>404 - Page Not Found</h1>"
                + "<p>Oops! The page you are looking for does not exist or has been moved.</p>"
                + "</body></html>";
            HTTP = "HTTP/1.1 404 Not Found\r\n"
                + "Content-Type: text/html\r\n"
                + "Content-Length: " + sizeof(BODY) + "\r\n"
                + "Connection: close\r\n\r\n";
        }

        socket_write(client, HTTP + BODY, sizeof(HTTP + BODY));
        socket_close(client);
        gc(); // Manual Garbage Collection
    }
}

socket_cleanup();